# Maintainer: Klaus Ahrenberg
# Nur für lokale Tests aus dem Projektordner (die Veröffentlichung im AUR: packaging/aur/PKGBUILD).
# Lokales Paket aus dem Projektordner:  cd packaging/arch && makepkg -f   (installieren: sudo pacman -U postfach-*.pkg.tar.zst)
pkgname=postfach
pkgver=0.1.0
pkgrel=1
pkgdesc='Schlanker IMAP-Mail-Client für GNOME (GTK4/libadwaita)'
arch=(any)
url='https://github.com/klausahrenberg/simple-gnome-mailer'
license=(GPL-3.0-or-later)
depends=(python python-gobject python-cairo gtk4 libadwaita webkitgtk-6.0 libsecret gdk-pixbuf2)
makedepends=(python-build python-installer python-setuptools python-wheel gettext)
optdepends=('gnome-online-accounts: Konten aus den GNOME-Einstellungen (Google, Microsoft 365)'
            'evolution-data-server: Kontaktfotos aus GNOME-Kontakten'
            'gnome-shell-extension-appindicator: Symbol in der Statusleiste')
# Quellen: der Projektordner (zwei Ebenen über diesem Verzeichnis)
source=()

prepare() {
  rm -rf "$srcdir/src"
  mkdir -p "$srcdir/src"
  # Projektordner ohne Paketier-Verzeichnis, Build-Reste und Caches kopieren
  tar -C "$startdir/../.." --exclude=./packaging --exclude=./build --exclude=./dist --exclude='*.egg-info' \
      --exclude=__pycache__ -cf - . | tar -C "$srcdir/src" -xf -
}

build() {
  cd "$srcdir/src"
  tools/build_locale.sh        # po/*.po -> postfach/locale/*/LC_MESSAGES/postfach.mo
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/src"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
